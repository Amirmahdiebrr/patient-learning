APP_NAME=CuraLink Patient Education Platform
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DEBUG=true

DATABASE_URL=postgresql+psycopg://curalink:curalink@localhost:5432/curalink_edu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

ACCESS_COOKIE_NAME=curalink_access_token
PATIENT_PROFILE_COOKIE_NAME=curalink_patient_profile
# Generate all secrets below at once with:
#   python -m scripts.generate_all_secrets
ACCESS_COOKIE_SECRET=
ACCESS_TOKEN_BYTES=32

AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-ai/deepseek-v4-pro

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Only used once by scripts/seed_lookup_data.py to bootstrap the first
# super_admin account. Leave unset after the first run.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Field-level encryption key for patient PII (national_id, phone, insurance).
ENCRYPTION_KEY=

# One-way HMAC key for searchable hashes of encrypted fields.
# Must be a DIFFERENT secret than ENCRYPTION_KEY - never reuse.
SEARCH_HASH_KEY=