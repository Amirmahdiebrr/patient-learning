APP_NAME=CuraLink Patient Education Platform
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DEBUG=true

DATABASE_URL=postgresql+psycopg://curalink:curalink@localhost:5432/curalink_edu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

ACCESS_COOKIE_NAME=curalink_access_token
PATIENT_PROFILE_COOKIE_NAME=curalink_patient_profile
ACCESS_COOKIE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_BYTES=32

AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-ai/deepseek-v4-pro

JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

